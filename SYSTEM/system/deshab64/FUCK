# Deshab Kernel Configuration
# 修改此文件可自定义内核启动行为、驱动加载和算法参数
# 路径: SYSTEM/system/deshab64/FUCK
# UTSM 通过 Limine boot module 预加载读取（cmdline="fuck:config")
# DSK 通过 FAT32 子目录遍历读取（路径 "SYSTEM  /DESHAB64 /FUCK    ")
# 缺失或空的键使用硬编码默认值，行为与无配置文件时一致

[boot]
vmm=1
linux_guest=1
selftest=1
dev_mode=0
# 真机安全: LA57 检测 (0=不检测, 1=检测并警告, 2=检测并拒绝启动)
# 真机若 BIOS 启用 5 级分页, 设 2 可阻止启动避免数据损坏
la57_guard=2
# 真机安全: PCIe MCFG 检测 (0=不检测, 1=检测并记录)
mcfg_check=1
# 真机安全: 允许的最大物理地址宽度 (超过则拒绝启动, 0=不限制)
# 典型值: 46 (QEMU), 48 (多数实机), 52 (服务器)
max_phys_addr_bits=0

[drivers]
timer=1
apic=1
acpi=1
pci=1
console_fb=1
ahci=1
nvme=1
bootfs=1
vfs=1
fat32=1
devfs=1
e1000=1
virtio_net=1
ath9k=0
ps2kbd=1
# 真机安全: 禁用不稳定的真机特性
# ioapic_init=0 可禁用 IOAPIC 重定向表编程 (留 PIC 模式)
ioapic_init=1
# lapic_enable=0 可禁用 LAPIC software enable (留 firmware 状态)
lapic_enable=1
# B7: APIC 路由接管开关 (apic.drv 自解析, 缺失=0)
# 0=保持 8259 PIC 路由 (默认, 现状不回归)
# 1=IOAPIC->LAPIC 接管: 注册 LAPIC EOI 钩子 + PIC IMR 全屏蔽 + TPR=0
#   + tick 链路自验 (vector 0x20, 失败自动完整降级回 PIC 并注销钩子)
apic_route=1
# B7 阶段2: 随 apic_route=1 额外放开 legacy IRQ1(键盘)/12(鼠标)/11(e1000)
# UTSM EOI 钩子已落地, 这些线可持续投递 (ISA 线 edge/high, e1000 强制
# level/active-low 按 PCI INTx 规范), 默认 0 关闭
# QEMU 全链路已验证 (B1 向导按键/B2 启动/e1000 IRQ11), 真机冒烟前可回 0
apic_route_legacy=1
# B7 阶段3: NVMe MSI/MSI-X 中断驱动开关 (nvme.drv 自解析, 缺失=1)
# 1=自动尝试: 先 MSI cap, 缺则 MSI-X (QEMU nvme 只有 MSI-X) — 表项编程
#   + 动态向量 (0x40-0xDF 池) + Create IOCQ IEN=1/IV=0 + INTMC 解除;
#   任何前提缺失 (无 MSI/MSI-X cap/旧内核无向量分配器/回读不符)
#   自动回退纯轮询, 行为与旧版一致
# 0=强制纯轮询 (CQE phase bit), 与 B7 阶段3 之前完全一致
nvme_msi=1
# B7 诊断 (apic.drv): 1=启用 HPET 绝对时基对拍 (tick 2x 定论实验) +
# IRQ12 鼠标流观察窗 (配合 QEMU monitor mouse_move), 只增观测不改路由语义
# 每次启动 +10s (6s 观察窗), 定论已完成 (PIT mode3 IOAPIC edge 双触发
# ~200Hz), 常规构建保持 0
apic_diag=0

[utsm]
max_segments=1024
max_capabilities=256
max_pckc_keys=8
dirty_shard_pages=1024
arena_size_mb=64
drr_emergency_pool_kb=64
drr_recovery_log_size=4096
drr_heartbeat_interval=0

[dsk]
show_logo=1
skip_login=1
default_shell=cmd
mouse_init=1
netman=1

[debug]
# 全局插桩开关 (0=禁用，零开销; 1=启用所有 INSTR_* 宏)
enabled=1
# 日志级别阈值 (0=TRACE, 1=DEBUG, 2=INFO, 3=WARN, 4=ERROR, 5=SILENT)
log_level=1
# 探测缓冲开关 (0=禁用; 1=启用 INSTR_PROBE 写入环形缓冲)
probe_enable=1
# 探测缓冲容量 (条目数，每条 40 字节，默认 4096 条 ≈ 160KB)
probe_capacity=4096
# 统计摘要间隔 (每 N 次增量输出一次摘要)
stat_summary_interval=256
# 模块级过滤: 1=启用该模块的 TRACE/DEBUG 级别日志
utsm_trace=1
vmm_trace=1
dkm_trace=1
dsk_trace=1
block_trace=1
net_trace=0
input_trace=1
