# Deshab Kernel Configuration (REALTEST - 实机开发测试)
# 基于 dev 配置, 启用磁盘日志持久化
# 启动时把完整日志写入磁盘 LBA 2-1000 扇区, 事后用 WinHex/dd 读取
# 路径: SYSTEM/system/deshab64/FUCK
# UTSM 通过 Limine boot module 预加载读取（cmdline="fuck:config")
# DSK 通过 FAT32 子目录遍历读取（路径 "SYSTEM  /DESHAB64 /FUCK    ")
# 缺失或空的键使用硬编码默认值，行为与无配置文件时一致

[boot]
vmm=1
linux_guest=1
# OpenXJ380 第二 guest：Phase 0 不需要，保持关闭
xj380_guest=0
# 2026-09-20: 并行会话新增的 chacha20 KAT 间歇性 FAIL 会 arch_halt_forever
# 挡死整条启动链（chacha20 本体运行路径不受影响），先跳过自测解锁桌面。
selftest=0
dev_mode=0
# 真机安全检查全部放宽（和 dev 一样），排除安全检查导致黑屏
la57_guard=0
mcfg_check=0
max_phys_addr_bits=0
# 实机启动日志持久化: 启用, 把启动日志写入 FAT32 文件
# SYSTEM/DESHAB64/DEV/BOOTLOG.TXT (DEV 缺失时回退根目录 BOOTLOG.TXT)
# 主机直接读取该文件即可, 不覆盖 GPT, 可反复烧录测试
disk_log=1

[drivers]
timer=1
apic=1
acpi=1
pci=1
console_fb=1
ahci=1
nvme=1
ehci=1
# xhci=1: xhci 驱动已修复无控制器时不再 halt，恢复启用
xhci=1
bootfs=1
vfs=1
fat32=1
devfs=1
e1000=1
virtio_net=1
ath9k=0
ps2kbd=1
ioapic_init=1
lapic_enable=1
apic_route=1
apic_route_legacy=1
nvme_msi=1
apic_diag=0

[utsm]
max_segments=1024
max_capabilities=256
max_pckc_keys=8
dirty_shard_pages=1024
arena_size_mb=64
drr_emergency_pool_kb=64
drr_recovery_log_size=4096
drr_heartbeat_interval=0

[sched]
# SAS-R0-PCQ 调度器（Phase 7）：tick=LAPIC timer（宿主自持）
enable=1
tick_hz=100
timeslice_ms=10
# demo 窗口忙等已加 tick 失速兜底（sched.c: 心跳无进展自动中止窗口），
# tick 不投递时不再卡死 bootstrap，窗口结束照常交接 DSK
# demo_fault=1 为看门狗负向测试（已验证通过），默认保持 0
demo_ms=1000
demo_fault=0

[drr]
# 恢复根（Phase 8）：快照区/看门狗默认启用，ckpt_max_pages 编译期 128
watchdog_enabled=1

[dsk]
show_logo=0
skip_login=1
mouse_init=1
netman=1
# session=native|kde|ask  (ask: 8s chooser, keyboard or serial '1'/'2')
# native: boot Deshab desktop; KDE icon in user/desktop launches Plasma
session=native

[debug]
enabled=1
log_level=1
probe_enable=1
probe_capacity=4096
stat_summary_interval=256
utsm_trace=1
vmm_trace=1
dkm_trace=1
dsk_trace=1
block_trace=1
net_trace=0
input_trace=1

[compat]
lib_path=lib
linux_lib_guest_path=/usr/lib/deshab
linux_lib_sync=1
pe_dll_search=1
