# Deshab Kernel Configuration — dev 变体（build/configs/dev/FUCK）
# build.ps1 -Variant dev 打包前注入 SYSTEM/system/deshab64/FUCK
# 开发者模式：selftest 开、dev_mode 自动跑 shell.elf 测试、日志持久化、跳过向导直达桌面

[boot]
vmm=1
linux_guest=1
xj380_guest=0
# F4: 分级自检 0=关 1=快速 2=全量（含 UTSM selftest；注意 chacha20 KAT 间歇 FAIL 会挡启动）
selftest=1
# F1 验证钩子: 1=启动自检后触发莲花崩溃屏（演示/回归用，日常保持 0）
panic_test=0
dev_mode=1
la57_guard=0
mcfg_check=0
max_phys_addr_bits=0
disk_log=1

[drivers]
timer=1
apic=1
acpi=1
pci=1
console_fb=1
ahci=1
nvme=1
ehci=1
xhci=1
bootfs=1
vfs=1
fat32=1
devfs=1
e1000=1
virtio_net=1
ath9k=0
ps2kbd=1
ioapic_init=1
lapic_enable=1
apic_route=1
apic_route_legacy=1
nvme_msi=1
apic_diag=0

[utsm]
max_segments=1024
max_capabilities=256
max_pckc_keys=8
dirty_shard_pages=1024
arena_size_mb=64
drr_emergency_pool_kb=64
drr_recovery_log_size=4096
drr_heartbeat_interval=0

[sched]
enable=1
tick_hz=100
timeslice_ms=10
demo_ms=1000
demo_fault=0

[drr]
watchdog_enabled=1

[dsk]
show_logo=0
skip_login=1
# F5: dev 直达桌面（跳过向导与登录）
skip_firstinit=1
mouse_init=1
netman=1
session=native

[debug]
enabled=1
log_level=1
probe_enable=1
probe_capacity=4096
stat_summary_interval=256
utsm_trace=1
vmm_trace=1
dkm_trace=1
dsk_trace=1
block_trace=1
net_trace=0
input_trace=1

[compat]
lib_path=lib
linux_lib_guest_path=/usr/lib/deshab
linux_lib_sync=1
pe_dll_search=1
