# Deshab Kernel Configuration (REALTEST - 实机开发测试)
# 基于 dev 配置, 启用磁盘日志持久化
# 启动时把完整日志写入磁盘 LBA 2-1000 扇区, 事后用 WinHex/dd 读取
# 路径: SYSTEM/system/deshab64/FUCK
# UTSM 通过 Limine boot module 预加载读取（cmdline="fuck:config")
# DSK 通过 FAT32 子目录遍历读取（路径 "SYSTEM  /DESHAB64 /FUCK    ")
# 缺失或空的键使用硬编码默认值，行为与无配置文件时一致

[boot]
vmm=0
linux_guest=0
# OpenXJ380 第二 guest：realtest 默认关闭（vmm=0 时天然不执行）
xj380_guest=0
selftest=1
dev_mode=1
# 真机安全检查全部放宽（和 dev 一样），排除安全检查导致黑屏
la57_guard=0
mcfg_check=0
max_phys_addr_bits=0
# 实机启动日志持久化: 启用, 把启动日志写入磁盘原始扇区
disk_log=1
disk_log_start=2
disk_log_end=1000

[drivers]
timer=1
apic=1
acpi=1
pci=1
console_fb=1
ahci=1
nvme=1
xhci=0
bootfs=1
vfs=1
fat32=1
devfs=1
e1000=1
virtio_net=1
ath9k=0
ps2kbd=1
ioapic_init=1
lapic_enable=1
apic_route=1
apic_route_legacy=1
nvme_msi=1
apic_diag=0

[utsm]
max_segments=1024
max_capabilities=256
max_pckc_keys=8
dirty_shard_pages=1024
arena_size_mb=64
drr_emergency_pool_kb=64
drr_recovery_log_size=4096
drr_heartbeat_interval=0

[dsk]
show_logo=1
skip_login=1
default_shell=cmd
mouse_init=1
netman=1

[debug]
enabled=1
log_level=1
probe_enable=1
probe_capacity=4096
stat_summary_interval=256
utsm_trace=1
vmm_trace=1
dkm_trace=1
dsk_trace=1
block_trace=1
net_trace=0
input_trace=1

[compat]
lib_path=lib
linux_lib_guest_path=/usr/lib/deshab
linux_lib_sync=1
pe_dll_search=1
