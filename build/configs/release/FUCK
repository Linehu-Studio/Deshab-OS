# Deshab Kernel Configuration — release 变体（build/configs/release/FUCK）
# build.ps1 -Variant release 打包前注入 SYSTEM/system/deshab64/FUCK
# 发布版：调试零开销、进登录+向导正常路径、真机安全选项

[boot]
vmm=0
linux_guest=0
xj380_guest=0
# F4: 分级自检（快速档，不含 UTSM selftest）
selftest=1
dev_mode=0
la57_guard=0
mcfg_check=0
max_phys_addr_bits=0
disk_log=0

[drivers]
timer=1
apic=1
acpi=1
pci=1
console_fb=1
ahci=1
nvme=1
ehci=1
xhci=1
bootfs=1
vfs=1
fat32=1
devfs=1
e1000=1
virtio_net=1
ath9k=0
ps2kbd=1
ioapic_init=1
lapic_enable=1
apic_route=1
apic_route_legacy=1
nvme_msi=1
apic_diag=0

[utsm]
max_segments=1024
max_capabilities=256
max_pckc_keys=8
dirty_shard_pages=1024
arena_size_mb=64
drr_emergency_pool_kb=64
drr_recovery_log_size=4096
drr_heartbeat_interval=0

[sched]
enable=1
tick_hz=100
timeslice_ms=10
demo_ms=0
demo_fault=0

[drr]
watchdog_enabled=1

[dsk]
show_logo=1
skip_login=0
# F5: release 走正常路径（向导/登录生效）
skip_firstinit=0
mouse_init=1
netman=1
session=native

[debug]
enabled=0
log_level=0
probe_enable=0
probe_capacity=4096
stat_summary_interval=0
utsm_trace=0
vmm_trace=0
dkm_trace=0
dsk_trace=0
block_trace=0
net_trace=0
input_trace=0

[compat]
lib_path=lib
linux_lib_guest_path=/usr/lib/deshab
linux_lib_sync=0
pe_dll_search=1
